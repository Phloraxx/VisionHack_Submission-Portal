# ──────────────────────────────────────────────────────────────────────────
# VisionHack Submission Portal V2 — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ──────────────────────────────────────────────────────────────────────────

# PocketBase ───────────────────────────────────────────────────────────────
# URL of the running PocketBase instance (no trailing slash).
POCKETBASE_URL=http://localhost:8090

# Admin credentials used by `npm run setup:pb` to provision collections,
# indexes, and API rules. Create this admin inside PocketBase first
# (`./pocketbase admin create <email> <password>`).
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (no trailing slash). Used to build
# absolute links in outbound email. Defaults to the production domain.
APP_URL=http://localhost:5173

# Comma-separated list of extra allowed Origin headers for cross-origin
# requests. In dev, localhost:5173/5174/5175 are always allowed.
# Example: https://visionhack.mulearn.org,https://staging.mulearn.org
ALLOWED_ORIGINS=

# Email (Resend) ───────────────────────────────────────────────────────────
# Resend API key for transactional email (status-change notifications).
# Leave unset in local dev — emails are skipped with a console warning.
RESEND_API_KEY=

# Observability (Sentry) ───────────────────────────────────────────────────
# Sentry DSN. Leave unset to disable Sentry.
SENTRY_DSN=

# Reverse proxy ────────────────────────────────────────────────────────────
# Set to "1" when running behind a trusted reverse proxy (nginx, Caddy, CF)
# so per-IP rate limiting reads X-Forwarded-For. Leaving unset in production
# forces a shared rate-limit bucket and logs a security warning.
TRUST_PROXY_HEADERS=

# Server ───────────────────────────────────────────────────────────────────
# Port the Node server listens on. Defaults to 3000.
PORT=3000

# Environment: "development" | "production". Falls back to "development".
NODE_ENV=development
