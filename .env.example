# Copy this to .env for local development / Node.js production.
# Environment variables are loaded at startup by dotenv.
# Never commit secrets.
PORT=3000
POCKETBASE_URL=https://your-pocketbase-instance.example.com
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,https://visionhack.mulearn.org
APP_URL=https://visionhack.mulearn.org
RESEND_API_KEY=
# Sentry error tracking (set DSN for production to enable)
SENTRY_DSN=
