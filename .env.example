# ──────────────────────────────────────────────────────────────────────────
# VisionHack Submission Portal V2 — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ──────────────────────────────────────────────────────────────────────────

# Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. The schema lives in `postgres/schema.sql`.
DATABASE_URL=postgres://visionhack:change-me@127.0.0.1:5432/visionhack

# HS256 signing key for session and password-reset tokens. At least 32 bytes —
# the server refuses to boot with a shorter one.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=

# Root of the submission-file volume. Created on first upload if missing.
UPLOADS_DIR=./uploads

# App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (no trailing slash). Used to build
# absolute links in outbound email. REQUIRED in production.
APP_URL=http://localhost:5173

# Comma-separated list of allowed Origin headers. REQUIRED in production —
# without it every same-origin POST is rejected with a 403.
# In dev, localhost:5173/5174/5175 are always allowed.
# Example: https://portal.example.org
ALLOWED_ORIGINS=

# Email (Resend) ───────────────────────────────────────────────────────────
# Resend API key for transactional email (status-change notifications).
# Leave unset in local dev — emails are skipped with a console warning.
RESEND_API_KEY=

# Observability (Sentry) ───────────────────────────────────────────────────
# Sentry DSN. Leave unset to disable Sentry.
SENTRY_DSN=

# Reverse proxy ────────────────────────────────────────────────────────────
# REQUIRED in production: set to "1" when running behind a trusted reverse
# proxy (nginx, Caddy, Cloudflare) so per-IP rate limiting reads
# CF-Connecting-IP / X-Forwarded-For. Without it every client shares one
# rate-limit bucket and the per-IP limit is skipped entirely.
TRUST_PROXY_HEADERS=

# Server ───────────────────────────────────────────────────────────────────
# Port the Node server listens on. Defaults to 3000.
PORT=3000

# Environment: "development" | "production". Falls back to "development".
NODE_ENV=development
