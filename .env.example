# Copy this to .env for local Node.js scripts (setup-pb.ts, etc.)
# Copy these to .dev.vars for `wrangler dev` / Miniflare local development
# For production, use `wrangler secret put <NAME>` — NEVER commit secrets.
POCKETBASE_URL=https://your-pocketbase-instance.example.com
POCKETBASE_SUPER_TOKEN=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,https://visionhack.mulearn.org
